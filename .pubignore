# Files and directories to exclude from pub.dev publishing

# Build artifacts
build/
coverage/
.dart_tool/

# IDE files
*.iml
*.ipr
*.iws
.idea/
.vscode/

# OS files
.DS_Store
Thumbs.db

# Test artifacts
test_report.md
*.log

# Development tools
tools/

# Documentation planning
*.plan.md
mcp_ui_designer_plan.md

# Git files
.git/
.gitignore

# Other
pubspec.lock

# Local resolution only — never part of the published archive. 0.5.0 shipped
# `example/pubspec_overrides.yaml` by accident: pub reads `.gitignore` for the
# package root, and the example resolves separately.
pubspec_overrides.yaml
**/pubspec_overrides.yaml
